# Smartclaw Configuration

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Gateway ---
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_MAX_CONNECTIONS=100

# --- Channels ---
WHATSAPP_TOKEN=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Security ---
SECURITY_NETWORK_ISOLATION=false
SECURITY_FILESYSTEM_RESTRICT=true
SECURITY_ALLOWED_PATHS=/tmp,/home
SECURITY_RATE_LIMIT_RPM=60
SECURITY_TOOL_CONFIRMATION=true
SECURITY_AUDIT_LOG_PATH=./logs/audit.jsonl

# --- Sandbox ---
SANDBOX_PROVIDER=process
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_MS=30000

# --- Prompt Engine ---
PROMPT_TOKEN_BUDGET=4096
PROMPT_QUALITY_GATE_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
